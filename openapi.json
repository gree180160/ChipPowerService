{
  "openapi": "3.0.0",
  "info": {
    "title": "ChipPower 数据服务 API",
    "version": "1.0.0",
    "description": "ChipPower 爬虫数据存储服务，支持所有 IC 相关数据表的读写操作"
  },
  "servers": [
    {
      "url": "http://localhost:5001/api/data",
      "description": "本地开发服务器"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["系统"],
        "summary": "健康检查",
        "responses": {
          "200": {
            "description": "服务正常",
            "content": {
              "application/json": {
                "example": {"code": 200, "message": "Success", "data": {"status": "ok", "message": "Data service is running"}}
              }
            }
          }
        }
      }
    },
    "/task/write": {
      "post": {
        "tags": ["Task 任务管理"],
        "summary": "写入/更新任务数据",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {"type": "array", "items": {"$ref": "#/components/schemas/Task"}},
              "example": [{"Tname": "crawler_task_001", "Tdes": "IC数据采集任务", "Tstate": "running", "Tlevel": 1}]
            }
          }
        },
        "responses": {"200": {"description": "写入成功"}}
      }
    },
    "/task/read": {
      "get": {
        "tags": ["Task 任务管理"],
        "summary": "查询任务数据",
        "parameters": [
          {"name": "Tname", "in": "query", "schema": {"type": "string"}},
          {"name": "Tstate", "in": "query", "schema": {"type": "string"}}
        ],
        "responses": {"200": {"description": "查询成功"}}
      }
    },
